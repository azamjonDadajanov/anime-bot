# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Telegram bot -----------------------------------------------------------
# Token issued by @BotFather, format: 123456789:ABC...
BOT_TOKEN=123456789:replace-me-with-the-botfather-token
# Kept for the website Telegram login widget (falls back to BOT_TOKEN if unset).
TELEGRAM_BOT_TOKEN=

# Comma separated Telegram user IDs allowed to use /admin. Nobody else can ever
# reach an administrative action, whatever they send.
ADMIN_IDS=111111111,222222222

# --- Bot behaviour ----------------------------------------------------------
# Seconds an FSM state row stays alive before cleanup deletes it.
BOT_FSM_TTL=86400
# Require membership of every active "required" channel before delivery.
BOT_REQUIRE_SUBSCRIPTION=true
# Publish new titles/episodes automatically to the selected public channel.
BOT_AUTO_PUBLISH=false
# Block forwarding/saving of delivered media.
BOT_PROTECT_CONTENT=true
# Broadcast throughput: messages per second and parallel Telegram requests.
BOT_BROADCAST_RATE=25
BOT_BROADCAST_CONCURRENCY=5
# Minimum seconds between two callback clicks from the same user (0 disables).
BOT_THROTTLE_RATE=0.4
# Items per page in every bot list.
BOT_PAGE_SIZE=8
# Optional channel that receives administrative audit events.
BOT_LOG_CHANNEL_ID=
# Console log level and the level persisted to bot.BotLogEntry (WARNING+).
BOT_LOG_LEVEL=INFO
BOT_DB_LOG_LEVEL=WARNING

# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=replace-me-with-50-random-characters
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---------------------------------------------------------------
# SQLite (development): leave DB_ENGINE as is and DB_NAME unset.
# PostgreSQL (production): DB_ENGINE=postgres and fill in the DB_* values.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Public website base URL the bot links to (used for manga reading links).
BOT_SITE_URL=http://localhost:5173
SUBSCRIPTION_CARD_NUMBER=8600 0000 0000 0000
SUBSCRIPTION_PRICE_FREE=0
SUBSCRIPTION_PRICE_PLUS=30000
SUBSCRIPTION_PRICE_PRO=50000
