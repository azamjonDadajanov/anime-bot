# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Telegram bot -----------------------------------------------------------
# Token issued by @BotFather, format: 123456789:ABC...
BOT_TOKEN=123456789:replace-me-with-the-botfather-token
# Kept for the website Telegram login widget (falls back to BOT_TOKEN if unset).
TELEGRAM_BOT_TOKEN=

# Comma separated Telegram user IDs allowed to use /admin. Nobody else can ever
# reach an administrative action, whatever they send.
ADMIN_IDS=111111111,222222222

# --- Bot behaviour ----------------------------------------------------------
# Seconds an FSM state row stays alive before cleanup deletes it.
BOT_FSM_TTL=86400
# Require membership of every active "required" channel before delivery.
BOT_REQUIRE_SUBSCRIPTION=true
# Publish new titles/episodes automatically to the selected public channel.
BOT_AUTO_PUBLISH=false
# Block forwarding/saving of delivered media.
BOT_PROTECT_CONTENT=true
# Broadcast throughput: messages per second and parallel Telegram requests.
BOT_BROADCAST_RATE=25
BOT_BROADCAST_CONCURRENCY=5
# Minimum seconds between two callback clicks from the same user (0 disables).
BOT_THROTTLE_RATE=0.4
# Items per page in every bot list.
BOT_PAGE_SIZE=8
# Optional channel that receives administrative audit events.
BOT_LOG_CHANNEL_ID=
# Console log level and the level persisted to bot.BotLogEntry (WARNING+).
BOT_LOG_LEVEL=INFO
BOT_DB_LOG_LEVEL=WARNING

# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=replace-me-with-50-random-characters
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---------------------------------------------------------------
# SQLite (development): leave DB_ENGINE as is and DB_NAME unset.
# PostgreSQL (production): DB_ENGINE=postgres and fill in the DB_* values.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Public website base URL the bot links to. Required for manga reading links
# and for PDF chapters: the bot never sends PDF files (they would be
# downloadable), it answers them with a reader link instead.
BOT_SITE_URL=http://localhost:5173
# Public HTTPS URL of the Telegram Mini App (the website) opened from
# inline buttons for sign-in/sign-up and in-app search. Telegram requires
# https; leave empty to hide the Mini App buttons.
BOT_WEBAPP_URL=https://yanking-earplugs-distance.ngrok-free.dev
SUBSCRIPTION_CARD_NUMBER=8600 0000 0000 0000
SUBSCRIPTION_PRICE_FREE=0
SUBSCRIPTION_PRICE_DAILY=6000
SUBSCRIPTION_PRICE_D15=10000
SUBSCRIPTION_PRICE_MONTHLY=25000
SUBSCRIPTION_PRICE_QUARTERLY=64000
SUBSCRIPTION_PRICE_YEARLY=220000

# --- AI yordamchi (AniVoy, faqat obunachilar uchun) --------------------------
# Offline model YO'Q: yordamchi faqat quyidagi online chat model orqali ishlaydi.
# U katalog funksiyalarini (qidiruv, kontent ma'lumoti, qismlar, janrlar) o'zi
# chaqiradi va shundan keyin javob yozadi (movies.ai_assistant).
# Kalit bo'lmasa yordamchi javob bera olmaydi — lokal zaxira yo'l yo'q.
AI_LLM_ENABLED=true
# Zanjir bazadan o'qiladi (/django-admin/ -> AI provayderlar): har bir qator
# alohida kalit/model/manzil. Biri limitga yetsa keyingisiga avtomatik
# o'tiladi, shuning uchun .env'dagi kalit faqat zaxira varianti.
# groq | gemini | openai | custom (custom uchun AI_LLM_BASE_URL kerak).
AI_LLM_PROVIDER=groq
# Groq kaliti: https://console.groq.com/keys (bepul developer tarifi bor).
AI_LLM_API_KEY=
# Bo'sh bo'lsa provayderning standart modeli olinadi:
#   groq -> qwen/qwen3.8-27b | gemini -> gemini-3.5-flash-lite
#   openai -> gpt-6-luna
AI_LLM_MODEL=
# Faqat custom provayder yoki boshqa OpenAI-mos gateway uchun.
AI_LLM_BASE_URL=
# Javob kutish vaqti (soniya): bitta provayder uchun. Tool chaqiruvlari ham shu
# chegara ichida bajariladi; vaqt tugasa zanjirdagi keyingi provayderga o'tiladi.
AI_LLM_TIMEOUT=8
# Butun zanjir uchun umumiy chegara (soniya). Barcha provayderlar o'lik bo'lsa
# yordamchi "hozircha javob bera olmaydi" deb xabar qaytaradi.
AI_LLM_DEADLINE=12
# Groq/OpenAI strict JSON rejimini qo'llaydi; tool chaqiruvlarda ishlatilmaydi.
AI_LLM_JSON_MODE=false

# --- Anime rating game (optional; defaults are fine) -------------------------
# Questions per quiz / answers needed to "verify" a title.
GAME_QUIZ_SIZE=5
GAME_PASS_SCORE=4
# Bot-delivered parts required before a title unlocks its quiz.
GAME_MIN_PARTS=3
# Server-side anti-cheat: a whole quiz faster than this * size gets 0 points.
GAME_MIN_ANSWER_SECONDS=3
# Seconds the bot gives for one question; a faster answer earns more points.
GAME_QUESTION_SECONDS=30
# How many quizzes a user may open per calendar day.
GAME_MAX_ATTEMPTS_PER_DAY=5
# Distinct active days in a month needed for the monthly prize shortlist.
GAME_ACTIVITY_DAYS=10
# Points for answering every question of one media type (divided per question).
GAME_POINTS_ANIME=10
GAME_POINTS_SERIES=10
GAME_POINTS_MOVIE=8
GAME_POINTS_MANGA=5
# Points needed per level step in the player ranking.
GAME_POINTS_PER_LEVEL=50
