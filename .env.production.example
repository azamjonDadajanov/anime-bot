# ---------------------------------------------------------------------------
# Production environment for docker-compose.yml (Django + nginx + bot).
#
#   cp .env.production.example .env
#   # fill in every value below, then: docker compose up -d --build
#
# `.env` holds real secrets: it is git-ignored and never copied into an image.
# For local development without Docker use kino_top/.env.example instead.
# ---------------------------------------------------------------------------

# --- Django -----------------------------------------------------------------
# 50+ random characters, e.g. `python -c "import secrets;print(secrets.token_urlsafe(64))"`.
DJANGO_SECRET_KEY=replace-me-with-50-random-characters
# Must stay false in production: with DEBUG on, error pages leak settings.
DJANGO_DEBUG=false
# Hosts the site is reachable at (comma separated, no scheme).
DJANGO_ALLOWED_HOSTS=anichopar.example.com,www.anichopar.example.com
# Origins allowed to call the API from a browser. With the SPA served by the
# same nginx the browser only makes same-origin requests, so this can list just
# the public site.
CORS_ALLOWED_ORIGINS=https://anichopar.example.com
# Origins trusted for state-changing requests, required to log into /admin/
# behind an https proxy.
CSRF_TRUSTED_ORIGINS=https://anichopar.example.com

# --- Database ---------------------------------------------------------------
# compose runs PostgreSQL and sets DB_ENGINE/DB_HOST/DB_PORT itself, so only the
# name and the credentials belong here.
DB_NAME=kino_top
DB_USER=kino_top
DB_PASSWORD=replace-me-with-a-strong-password
DB_CONN_MAX_AGE=60

# --- Published port ---------------------------------------------------------
# Host port that nginx listens on (80 by default; use 8080 if 80 is taken).
HTTP_PORT=80

# --- Telegram bot -----------------------------------------------------------
# Token issued by @BotFather.
BOT_TOKEN=123456789:replace-me-with-the-botfather-token
# Same token, used by the website Telegram login widget.
TELEGRAM_BOT_TOKEN=
# Comma separated Telegram user IDs allowed to use /admin.
ADMIN_IDS=111111111
# Public website URL the bot links to (manga reading links, deep links).
BOT_SITE_URL=https://anichopar.example.com
# Public HTTPS URL of the Telegram Mini App (the website) opened from
# inline buttons for sign-in/sign-up and in-app search. Telegram requires
# https; leave empty to hide the Mini App buttons.
BOT_WEBAPP_URL=https://yanking-earplugs-distance.ngrok-free.dev

BOT_FSM_TTL=86400
BOT_REQUIRE_SUBSCRIPTION=true
BOT_AUTO_PUBLISH=false
BOT_PROTECT_CONTENT=true
BOT_BROADCAST_RATE=25
BOT_BROADCAST_CONCURRENCY=5
BOT_THROTTLE_RATE=0.4
BOT_PAGE_SIZE=8
BOT_LOG_CHANNEL_ID=
BOT_LOG_LEVEL=INFO
BOT_DB_LOG_LEVEL=WARNING

# --- Subscription payment ---------------------------------------------------
SUBSCRIPTION_CARD_NUMBER=8600 0000 0000 0000
SUBSCRIPTION_PRICE_FREE=0
SUBSCRIPTION_PRICE_DAILY=6000
SUBSCRIPTION_PRICE_D15=10000
SUBSCRIPTION_PRICE_MONTHLY=25000
SUBSCRIPTION_PRICE_QUARTERLY=64000
SUBSCRIPTION_PRICE_YEARLY=220000
