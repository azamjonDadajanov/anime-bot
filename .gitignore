# ---------------------------------------------------------------------------
# Secrets and environment
# ---------------------------------------------------------------------------
.env
.env.production
.env.production.local
*.pem
*.key

# Local dev artifacts that may contain real tokens or session state.
# Never commit these — regenerate them locally instead.
.sisyphus/
# Telethon authorization session (chopar) — created by `python main.py login`.
*.session
*.session-journal
chopar/data/
frontend/public/dev-session.json
frontend/public/*.local

# ---------------------------------------------------------------------------
# Python / Django
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Local database, collected static files and user uploads (manga PDFs,
# subscription screenshots). Production keeps these in PostgreSQL and volumes.
db.sqlite3
db.sqlite3-journal
staticfiles/
media/

# ACME http-01 webroot served by the nginx container (see docker-compose.yml).
certbot-www/
# Copy of the Let's Encrypt certificate (private key!) the container mounts.
certs/

.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# ---------------------------------------------------------------------------
# Node / Vite (React SPA + Game)
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/

# Game (Three.js mini app) — build artifacts
game/dist/
game/node_modules/
game/.env*.local

# Frontend SPA — build artifacts
frontend/dist/
frontend/node_modules/

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.sw?

# ---------------------------------------------------------------------------
# Tooling
# ---------------------------------------------------------------------------
.freebuff/
.tmp_deploy/
*.log
